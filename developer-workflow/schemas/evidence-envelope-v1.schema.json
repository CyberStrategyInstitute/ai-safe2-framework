{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cyberstrategyinstitute.com/ai-safe2/evidence-envelope-v1.schema.json",
  "title": "AI SAFE2 Evidence Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "subject", "producer", "execution", "observations", "findings", "limitations", "artifacts", "integrity"],
  "properties": {
    "schema_version": {"const": "ai-safe2.evidence-envelope.v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identifier", "revision", "scope"],
      "properties": {
        "type": {"enum": ["repository_change", "release", "runtime_action", "everyday_decision"]},
        "identifier": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "name", "version"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started_at", "completed_at", "policy_digest"],
      "properties": {
        "status": {"enum": ["not_requested", "unavailable", "failed", "produced"]},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "policy_digest": {"type": "string", "minLength": 1},
        "failure_reason": {"type": ["string", "null"]}
      }
    },
    "observations": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "signature"],
      "properties": {
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signature": {"type": ["string", "null"]}
      }
    }
  }
}

