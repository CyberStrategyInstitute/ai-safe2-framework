      "assessment_schema": "safe2/data/aism-assessment-v1.schema.json",
      "challenge_workflow": "docs/CHALLENGE-CLI.md",
      "challenge_quickstart": "safe2 challenge quickstart 001 --output-dir my-first-run",
      "challenge_verification": "safe2 challenge verify-bundle my-first-run",
      "challenge_controlled_execution": "safe2 challenge plan 001 ... then safe2 challenge execute PLAN --authorize-process-execution",
      "evidence_workflow": "safe2 evidence ... then safe2 aism ingest ...",
      "operational_truth_workflow": "safe2 evidence truth POLICY EVIDENCE... --output FILE --card FILE",
      "agent_input_monitor": "safe2 evidence changes ROOT --baseline FILE --output FILE",
      "continuous_agent_input_monitor": "safe2 evidence watch ROOT --state FILE --evidence-dir DIR --continuous",
      "adapter_conformance": "safe2 adapter conformance DESCRIPTOR SPECIMENS... --output FILE",
      "codex_adapter": "safe2 adapter codex-jsonl TRACE --codex-version VERSION --output FILE",
      "opentelemetry_adapter": "safe2 adapter otel-jsonl TRACE --otel-version VERSION --output FILE",
      "claim_audit": "safe2 evidence claims SOURCE RECEIPTS... --output FILE --card FILE",
      "installation_check": "safe2 self-check --strict",
      "stranger_acceptance": "safe2 acceptance run DIRECTORY --strict then safe2 acceptance verify DIRECTORY",
      "aism_remediation_workflow": "safe2 aism plan SOURCE ASSESSMENT --system-identity FILE --assessment-scope FILE --output FILE --card FILE",
      "development_workflow": "safe2 dev plan SOURCE --output PLAN then safe2 dev receipt PLAN SOURCE --artifact-root DIR --output RECEIPT"
