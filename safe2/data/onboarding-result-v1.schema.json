{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/safe2/onboarding-result-v1.schema.json",
  "title": "AI SAFE2 Guided Onboarding Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "completed_at", "status", "configuration", "assessment_summary", "artifacts", "authorization", "limitations", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "safe2.onboarding-result.v1"},
    "plan_id": {"type": "string", "pattern": "^safe2-start-[a-f0-9]{16}$"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "completed"},
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "outcome"],
      "properties": {"path": {"type": "string", "minLength": 1}, "outcome": {"enum": ["created", "reused"]}}
    },
    "assessment_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "evidence_confidence", "harnesses_detected", "assets_inventoried", "environment_findings", "static_violations"],
      "properties": {
        "disposition": {"enum": ["BASELINE", "REVIEW", "INCOMPLETE"]},
        "evidence_confidence": {"enum": ["LOW", "LIMITED", "MODERATE"]},
        "harnesses_detected": {"type": "integer", "minimum": 0},
        "assets_inventoried": {"type": "integer", "minimum": 0},
        "environment_findings": {"type": "integer", "minimum": 0},
        "static_violations": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "assessment", "assessment_card", "next_step_card", "configuration_snapshot"],
      "properties": {
        "plan": {"const": "onboarding-plan.json"},
        "assessment": {"const": "assessment/assessment.json"},
        "assessment_card": {"const": "assessment/decision-card.md"},
        "next_step_card": {"const": "next-step-card.md"},
        "configuration_snapshot": {"const": "configuration-snapshot.toml"}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["remediate", "deploy", "publish", "claim_conformance"],
      "properties": {"remediate": {"const": false}, "deploy": {"const": false}, "publish": {"const": false}, "claim_conformance": {"const": false}}
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}},
    "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
