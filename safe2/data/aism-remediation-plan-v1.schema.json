{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/aism-remediation-plan-v1.json",
  "title": "AISM implementation remediation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "plan_id", "subject", "decision_owner", "source", "bindings", "assessment", "gaps", "assumptions", "actions", "alternatives", "accepted_residual_risks", "history", "summary", "decision", "limitations"],
  "properties": {
    "schema_version": {"const": "safe2.aism-remediation-plan.v1"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 50},
    "plan_id": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/id"},
    "subject": {"$ref": "https://cyberstrategyinstitute.com/ai-safe2/schemas/aism-assessment-v1.schema.json#/properties/subject"},
    "decision_owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "bytes", "authentication"],
      "properties": {
        "sha256": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "authentication": {"const": "not_checked"}
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment_sha256", "system_identity_sha256", "assessment_scope_sha256", "system_fingerprint_sha256", "scope_id"],
      "properties": {
        "assessment_sha256": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/sha256"},
        "system_identity_sha256": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/sha256"},
        "assessment_scope_sha256": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/sha256"},
        "system_fingerprint_sha256": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/sha256"},
        "scope_id": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/id"}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_score", "evidence_adjusted_score", "target", "completeness", "maturity", "normative_score_unchanged"],
      "properties": {
        "raw_score": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "evidence_adjusted_score": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "target": {"type": "number", "minimum": 1, "maximum": 5},
        "completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "maturity": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["level", "minimum", "name", "description", "aliases"],
              "properties": {
                "level": {"type": "integer", "minimum": 1, "maximum": 5},
                "minimum": {"type": "number", "minimum": 0, "maximum": 5},
                "name": {"type": "string", "minLength": 1, "maxLength": 100},
                "description": {"type": "string", "minLength": 1, "maxLength": 300},
                "aliases": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
              }
            }
          ]
        },
        "normative_score_unchanged": {"const": true}
      }
    },
    "gaps": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cell", "type", "score", "target", "action_ids"],
        "properties": {
          "cell": {"type": "string", "pattern": "^P[1-5]\\.D[1-6]$"},
          "type": {"enum": ["not_assessed", "below_target"]},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
          "target": {"type": "number", "minimum": 1, "maximum": 5},
          "action_ids": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/id"}}
        }
      }
    },
    "assumptions": {"type": "array", "maxItems": 200, "items": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/statement"}},
    "actions": {"type": "array", "maxItems": 500, "items": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/action"}},
    "alternatives": {"type": "array", "maxItems": 100, "items": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/alternative"}},
    "accepted_residual_risks": {"type": "array", "maxItems": 200, "items": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/risk"}},
    "history": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["recorded_at", "action_id", "from", "to", "basis"],
        "properties": {
          "recorded_at": {"type": "string", "format": "date-time", "maxLength": 50},
          "action_id": {"$ref": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json#/$defs/id"},
          "from": {"type": ["string", "null"], "maxLength": 50},
          "to": {"type": ["string", "null"], "maxLength": 50},
          "basis": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["gaps", "uncovered_gaps", "actions", "open_actions", "completed_actions", "blocked_actions", "accepted_risks"],
      "properties": {
        "gaps": {"type": "integer", "minimum": 0, "maximum": 30},
        "uncovered_gaps": {"type": "integer", "minimum": 0, "maximum": 30},
        "actions": {"type": "integer", "minimum": 0, "maximum": 500},
        "open_actions": {"type": "integer", "minimum": 0, "maximum": 500},
        "completed_actions": {"type": "integer", "minimum": 0, "maximum": 500},
        "blocked_actions": {"type": "integer", "minimum": 0, "maximum": 500},
        "accepted_risks": {"type": "integer", "minimum": 0, "maximum": 200}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "reason", "human_owned", "remediation_authorized", "conformance_claim"],
      "properties": {
        "gate": {"enum": ["hold", "review", "ready_for_human_decision"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "human_owned": {"const": true},
        "remediation_authorized": {"const": false},
        "conformance_claim": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 4, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
