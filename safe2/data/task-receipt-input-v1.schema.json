{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/task-receipt-input-v1.json",
  "title": "Task receipt input: claims are untrusted declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "parent_task_id", "harness", "criteria", "usage"],
  "properties": {
    "schema_version": {"const": "safe2.task-receipt-input.v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "parent_task_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "harness": {"$ref": "#/$defs/id"},
    "criteria": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "path", "expected_sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["artifact_sha256", "test_report", "tool_report"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "attestation_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "expected_revision": {"$ref": "#/$defs/id"},
          "expected_environment": {"$ref": "#/$defs/id"},
          "expected_call_id": {"$ref": "#/$defs/id"},
          "expected_tool": {"$ref": "#/$defs/id"},
          "claimed_outcome": {"enum": ["succeeded", "unavailable", "failed"]}
        },
        "allOf": [{
          "if": {"properties": {"kind": {"enum": ["test_report", "tool_report"]}}},
          "then": {"required": ["expected_revision", "expected_environment"]},
          "else": {"not": {"anyOf": [{"required": ["expected_revision"]}, {"required": ["expected_environment"]}, {"required": ["attestation_path"]}]}}
        }, {
          "if": {"properties": {"kind": {"const": "tool_report"}}},
          "then": {"required": ["expected_call_id", "expected_tool", "claimed_outcome"]},
          "else": {"not": {"anyOf": [{"required": ["expected_call_id"]}, {"required": ["expected_tool"]}, {"required": ["claimed_outcome"]}]}}
        }]
      }
    },
    "usage": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "metric", "value", "basis", "source_ref"],
        "properties": {
          "event_id": {"$ref": "#/$defs/id"},
          "metric": {"enum": ["input_tokens", "output_tokens", "elapsed_ms", "api_cost_usd"]},
          "value": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1000000000000}, {"type": "null"}]},
          "basis": {"enum": ["provider_reported", "estimated", "unknown"]},
          "source_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"}
  }
}
