{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.org/schemas/challenge-comparison-v1.schema.json",
  "title": "Challenge Lab comparison v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "safe2.challenge-comparison.v1"
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "left": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "integrity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "native_fixture",
                "synthetic_import",
                "external_import"
              ]
            },
            "producer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "adapter_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "source_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_run_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "source_hash_basis": {
              "enum": [
                "original_bytes",
                "canonical_json",
                null
              ]
            }
          },
          "required": [
            "kind",
            "producer_id",
            "adapter_id",
            "adapter_version",
            "source_sha256",
            "source_run_id",
            "source_hash_basis"
          ]
        }
      },
      "required": [
        "run_id",
        "integrity_sha256",
        "provider",
        "provenance"
      ]
    },
    "right": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "integrity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "native_fixture",
                "synthetic_import",
                "external_import"
              ]
            },
            "producer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "adapter_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "source_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_run_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "source_hash_basis": {
              "enum": [
                "original_bytes",
                "canonical_json",
                null
              ]
            }
          },
          "required": [
            "kind",
            "producer_id",
            "adapter_id",
            "adapter_version",
            "source_sha256",
            "source_run_id",
            "source_hash_basis"
          ]
        }
      },
      "required": [
        "run_id",
        "integrity_sha256",
        "provider",
        "provenance"
      ]
    },
    "comparable": {
      "type": "boolean"
    },
    "mismatches": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "outcome_agreement": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evaluated_pairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1800
            },
            "agreements": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1800
            },
            "disagreements": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1800
            },
            "incomplete_pairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1800
            },
            "conflict_pairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1800
            },
            "rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "evaluated_pairs",
            "agreements",
            "disagreements",
            "incomplete_pairs",
            "conflict_pairs",
            "rate"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "independent_replication": {
      "const": "not_established"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "integrity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "comparison_id",
    "created_at",
    "left",
    "right",
    "comparable",
    "mismatches",
    "outcome_agreement",
    "independent_replication",
    "limitations",
    "integrity_sha256"
  ]
}
