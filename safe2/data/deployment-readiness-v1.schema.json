{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/deployment-readiness-v1",
  "title": "Scoped deployment readiness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_version",
    "system_id",
    "revision",
    "scope",
    "required_controls",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "safe2.deployment-readiness.v1"
    },
    "framework_version": {
      "const": "3.5.0"
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "required_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "revision",
          "scope",
          "result",
          "evidence_id",
          "independence",
          "observed_at",
          "valid_until"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "untested"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "independence": {
            "enum": [
              "independent",
              "self-reported",
              "unknown"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
