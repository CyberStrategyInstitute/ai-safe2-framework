{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/development-policy-v1.json",
  "title": "AI SAFE2 Development Method Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "delivery_shapes", "risk_tiers", "test_modes_by_change_kind", "evidence_by_change_kind", "greptile_recommended_for"],
  "properties": {
    "schema_version": {"const": "safe2.development-policy.v1"},
    "policy_id": {"$ref": "#/$defs/id"},
    "delivery_shapes": {
      "type": "object", "additionalProperties": false,
      "required": ["spike", "bounded", "architectural"],
      "properties": {
        "spike": {"$ref": "#/$defs/shape"},
        "bounded": {"$ref": "#/$defs/shape"},
        "architectural": {"$ref": "#/$defs/shape"}
      }
    },
    "risk_tiers": {
      "type": "object", "additionalProperties": false,
      "required": ["low", "medium", "high", "critical"],
      "properties": {
        "low": {"$ref": "#/$defs/tier"},
        "medium": {"$ref": "#/$defs/tier"},
        "high": {"$ref": "#/$defs/tier"},
        "critical": {"$ref": "#/$defs/tier"}
      }
    },
    "test_modes_by_change_kind": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "configuration", "documentation", "research"],
      "properties": {
        "code": {"$ref": "#/$defs/test_modes"},
        "configuration": {"$ref": "#/$defs/test_modes"},
        "documentation": {"$ref": "#/$defs/test_modes"},
        "research": {"$ref": "#/$defs/test_modes"}
      }
    },
    "evidence_by_change_kind": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "configuration", "documentation", "research"],
      "properties": {
        "code": {"$ref": "#/$defs/evidence"},
        "configuration": {"$ref": "#/$defs/evidence"},
        "documentation": {"$ref": "#/$defs/evidence"},
        "research": {"$ref": "#/$defs/evidence"}
      }
    },
    "greptile_recommended_for": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["low", "medium", "high", "critical"]}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "evidence": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "test_modes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/test_mode"}},
    "test_mode": {"enum": ["tdd", "characterization-first", "contract-first", "schema-validation", "render-validation", "approved-spike", "not-applicable"]},
    "shape": {
      "type": "object", "additionalProperties": false,
      "required": ["design_artifact", "human_design_approval", "reusable_output_allowed", "review_cadence", "required_evidence"],
      "properties": {
        "design_artifact": {"enum": ["hypothesis-and-discard-plan", "acceptance-conditions-and-scope", "written-spec-and-plan"]},
        "human_design_approval": {"type": "boolean"},
        "reusable_output_allowed": {"type": "boolean"},
        "review_cadence": {"$ref": "#/$defs/cadence"},
        "required_evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "tier": {
      "type": "object", "additionalProperties": false,
      "required": ["human_design_approval", "threat_model_required", "review_cadence", "required_evidence"],
      "properties": {
        "human_design_approval": {"type": "boolean"},
        "threat_model_required": {"type": "boolean"},
        "review_cadence": {"$ref": "#/$defs/cadence"},
        "required_evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "cadence": {"enum": ["completion", "subsystem", "task", "task-and-specialist"]}
  }
}
