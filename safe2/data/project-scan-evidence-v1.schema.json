{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/safe2/project-scan-evidence-v1.schema.json",
  "title": "AI SAFE2 Project Scan Evidence",
  "type": "object",
  "required": ["schema_version", "collected_at", "scope", "collector", "status", "content_read_locally", "result", "limitations", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "safe2.project-scan-evidence.v1"},
    "collected_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "object", "required": ["root"], "properties": {"root": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "collector": {"type": "object", "required": ["name", "version", "engine"], "properties": {"name": {"const": "safe2"}, "version": {"type": "string"}, "engine": {"const": "static-project-scan"}}, "additionalProperties": false},
    "status": {"enum": ["completed", "incomplete", "not_requested"]},
    "content_read_locally": {"type": "boolean"},
    "result": {"type": ["object", "null"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"content_read_locally": {"const": true}, "result": {"type": "object"}}}},
    {"if": {"properties": {"status": {"const": "incomplete"}}}, "then": {"properties": {"content_read_locally": {"const": true}, "result": {"type": "object"}}}},
    {"if": {"properties": {"status": {"const": "not_requested"}}}, "then": {"properties": {"content_read_locally": {"const": false}, "result": {"type": "null"}}}}
  ],
  "additionalProperties": false
}
