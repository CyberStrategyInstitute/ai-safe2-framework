{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/safe2/project-assessment-v1.schema.json",
  "title": "AI SAFE2 Unified Project Assessment",
  "type": "object",
  "required": ["schema_version", "assessment_id", "created_at", "subject", "configuration", "summary", "coverage", "artifacts", "next_actions", "decision_scope", "limitations", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "safe2.project-assessment.v1"},
    "assessment_id": {"type": "string", "pattern": "^safe2-assessment-"},
    "created_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "object", "required": ["id", "root"], "properties": {"id": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "configuration": {"type": "object", "required": ["schema_version", "source", "profile"], "properties": {"schema_version": {"const": "safe2.config.v1"}, "source": {"enum": ["explicit", "environment", "project", "defaults"]}, "profile": {"enum": ["local", "ci", "enterprise"]}}, "additionalProperties": false},
    "summary": {
      "type": "object",
      "required": ["disposition", "evidence_confidence", "harnesses_detected", "assets_inventoried", "environment_findings", "static_violations"],
      "properties": {
        "disposition": {"enum": ["BASELINE", "REVIEW", "INCOMPLETE"]},
        "evidence_confidence": {"enum": ["LOW", "LIMITED", "MODERATE"]},
        "harnesses_detected": {"type": "integer", "minimum": 0},
        "assets_inventoried": {"type": "integer", "minimum": 0},
        "environment_findings": {"type": "integer", "minimum": 0},
        "static_violations": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "coverage": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["surface", "status", "meaning"], "properties": {"surface": {"type": "string"}, "status": {"enum": ["complete", "not_requested", "not_assessed", "incomplete"]}, "meaning": {"type": "string"}}, "additionalProperties": false}},
    "artifacts": {"type": "object", "required": ["environment", "project_scan", "manifest", "card"], "additionalProperties": {"type": "string"}},
    "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision_scope": {"const": "human_review_support_only"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
