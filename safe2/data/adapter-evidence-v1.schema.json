{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cyberstrategyinstitute.com/schemas/safe2/adapter-evidence-v1.schema.json","type":"object","required":["schema_version","evidence_id","adapter_id","adapter_version","provider","evidence_type","observed_at","status","decision_scope","conformance_claim","coverage","claims","payload","provenance"],"properties":{"schema_version":{"const":"safe2.adapter-evidence.v1"},"evidence_id":{"type":"string","minLength":1,"maxLength":200},"adapter_id":{"type":"string"},"adapter_version":{"type":"string"},"provider":{"type":"object","required":["name","version"],"properties":{"name":{"type":"string"},"version":{"type":"string"}},"additionalProperties":false},"evidence_type":{"enum":["harness","scanner","evaluator","ledger","usage","cloud"]},"observed_at":{"type":"string","format":"date-time"},"status":{"enum":["complete","partial","unavailable"]},"decision_scope":{"const":"evidence_only"},"conformance_claim":{"const":false},"coverage":{"type":"object","required":["inspected","gaps"],"properties":{"inspected":{"type":"array","items":{"type":"string"}},"gaps":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},"claims":{"type":"array","items":{"type":"object","required":["id","name","value","basis","source_ref"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"value":{},"basis":{"enum":["observed","provider_reported","declared","unknown"]},"source_ref":{"type":["string","null"]}},"additionalProperties":false}},"payload":{"type":["object","array","string","number","boolean","null"]},"provenance":{"type":"object","required":["source","source_sha256"],"properties":{"source":{"type":"string","minLength":1},"source_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},"additionalProperties":false}
