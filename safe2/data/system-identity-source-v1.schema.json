{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/system-identity-source-v1.json",
  "title": "Provider-neutral agent system identity source; contents remain attributed assertions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "declared_at", "subject", "components", "bindings", "coverage", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "safe2.system-identity-source.v1"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "declared_at": {"type": "string", "format": "date-time", "maxLength": 50},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "name", "deployment_id"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/text"},
        "deployment_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "components": {
      "type": "array", "minItems": 3, "maxItems": 1000,
      "items": {"$ref": "#/$defs/component"}
    },
    "bindings": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["binding_id", "from_component_id", "to_component_id", "relationship", "basis", "source_ref"],
        "properties": {
          "binding_id": {"$ref": "#/$defs/id"},
          "from_component_id": {"$ref": "#/$defs/id"},
          "to_component_id": {"$ref": "#/$defs/id"},
          "relationship": {"enum": ["uses", "runs_on", "governed_by", "evaluated_by", "delegates_to", "reads_from", "writes_to", "invokes"]},
          "basis": {"$ref": "#/$defs/basis"},
          "source_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "harness", "tool", "skill", "memory", "environment", "policy", "evaluator"],
      "properties": {
        "model": {"$ref": "#/$defs/coverage"},
        "harness": {"$ref": "#/$defs/coverage"},
        "tool": {"$ref": "#/$defs/coverage"},
        "skill": {"$ref": "#/$defs/coverage"},
        "memory": {"$ref": "#/$defs/coverage"},
        "environment": {"$ref": "#/$defs/coverage"},
        "policy": {"$ref": "#/$defs/coverage"},
        "evaluator": {"$ref": "#/$defs/coverage"}
      }
    },
    "evidence_refs": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "schema_version", "sha256", "relationship", "source_ref"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/id"},
          "schema_version": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "relationship": {"enum": ["supports_identity", "describes_environment", "evaluates_subject"]},
          "source_ref": {"$ref": "#/$defs/id"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 200},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "basis": {"enum": ["observed", "declared", "unknown"]},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "category", "name", "provider", "version", "artifact_sha256", "role", "authority", "basis", "source_ref"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "category": {"enum": ["model", "harness", "tool", "skill", "memory", "environment", "policy", "evaluator"]},
        "name": {"$ref": "#/$defs/text"},
        "provider": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "version": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "artifact_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "role": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "authority": {
          "type": "array", "uniqueItems": true, "maxItems": 8,
          "items": {"enum": ["read", "write", "execute", "network", "delegate", "approve", "admin", "unknown"]}
        },
        "basis": {"$ref": "#/$defs/basis"},
        "source_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "basis", "source_ref"],
      "properties": {
        "status": {"enum": ["complete", "partial", "missing", "not_applicable"]},
        "basis": {"$ref": "#/$defs/basis"},
        "source_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    }
  }
}
