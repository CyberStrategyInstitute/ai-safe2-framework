{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/review-policy-v1.json",
  "title": "AI SAFE2 Repository Review Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "default_tier", "tiers", "rules", "greptile", "decision_owner", "retention_days"],
  "properties": {
    "schema_version": {"const": "ai-safe2.review-policy.v1"},
    "policy_id": {"$ref": "#/$defs/id"},
    "default_tier": {"$ref": "#/$defs/tier"},
    "tiers": {"type": "array", "const": ["low", "medium", "high", "critical"]},
    "rules": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tier", "patterns", "reason", "required_evidence", "review_lenses"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "tier": {"$ref": "#/$defs/tier"},
          "patterns": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "required_evidence": {"$ref": "#/$defs/id_array"},
          "review_lenses": {"$ref": "#/$defs/id_array"}
        }
      }
    },
    "greptile": {
      "type": "object", "additionalProperties": false,
      "required": ["recommend_for", "also_when", "blocking"],
      "properties": {
        "recommend_for": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tier"}},
        "also_when": {"$ref": "#/$defs/id_array"},
        "blocking": {"const": false}
      }
    },
    "decision_owner": {"$ref": "#/$defs/id"},
    "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "tier": {"enum": ["low", "medium", "high", "critical"]},
    "id_array": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
