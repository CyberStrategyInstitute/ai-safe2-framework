{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.org/schemas/challenge-execution-plan-v1.schema.json",
  "title": "Challenge Lab controlled execution pre-registration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "safe2.challenge-execution-plan.v1"},
    "challenge_id": {"const": "001"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
    "treatment": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "producer_id": {"type": "string", "pattern": "^[A-Za-z0-9._:@/-]{1,200}$"}
      },
      "required": ["name", "version", "producer_id"]
    },
    "command": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command_file_bindings": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "argument_index": {"type": "integer", "minimum": 0, "maximum": 31},
          "path": {"type": "string", "minLength": 1, "maxLength": 2048},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["argument_index", "path", "sha256"]
      }
    },
    "system_identity_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 300},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760}
      },
      "required": ["timeout_seconds", "max_output_bytes"]
    },
    "acknowledgements": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "explicit_process_execution": {"const": true},
        "not_a_sandbox": {"const": true},
        "independence_not_established": {"const": true}
      },
      "required": ["explicit_process_execution", "not_a_sandbox", "independence_not_established"]
    }
  },
  "required": ["schema_version", "challenge_id", "seed", "repetitions", "treatment", "provider", "command", "executable_sha256", "command_file_bindings", "system_identity_sha256", "limits", "acknowledgements"]
}
