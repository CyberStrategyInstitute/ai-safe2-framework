{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cyberstrategyinstitute.com/schemas/safe2/adapter-descriptor-v1.schema.json","type":"object","required":["schema_version","adapter_id","version","provider","evidence_types","decision_scope","transport","privacy"],"properties":{"schema_version":{"const":"safe2.adapter.v1"},"adapter_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,99}$"},"version":{"type":"string","minLength":1,"maxLength":100},"provider":{"type":"object","required":["name","version"],"properties":{"name":{"type":"string","minLength":1,"maxLength":200},"version":{"type":"string","minLength":1,"maxLength":100}},"additionalProperties":false},"evidence_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["harness","scanner","evaluator","ledger","usage","cloud"]}},"decision_scope":{"const":"evidence_only"},"transport":{"enum":["file","process","api"]},"privacy":{"type":"object","required":["content_collection","network_required","credential_required"],"properties":{"content_collection":{"enum":["none","metadata","content"]},"network_required":{"type":"boolean"},"credential_required":{"type":"boolean"}},"additionalProperties":false}},"additionalProperties":false}
