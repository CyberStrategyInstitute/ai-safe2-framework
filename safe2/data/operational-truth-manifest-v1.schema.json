{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/operational-truth-manifest-v1.json",
  "title": "Operational truth task evidence synthesis",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "created_at", "task", "inputs", "coverage", "events", "usage", "completion", "gaps", "conflicts", "gate", "decision_owner", "assumptions", "exclusions", "completion_verified", "billing_verified", "conformance_claim", "limitations"],
  "properties": {
    "schema_version": {"const": "safe2.operational-truth-manifest.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "task": {"type": "object", "additionalProperties": false, "required": ["task_id", "revision", "harnesses"], "properties": {"task_id": {"type": "string"}, "revision": {"type": "string"}, "harnesses": {"type": "array", "items": {"type": "string"}}}},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["schema_version", "sha256", "bytes"], "properties": {"schema_version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}},
    "coverage": {"type": "object", "additionalProperties": {"enum": ["complete", "partial", "missing"]}},
    "events": {"type": "object", "additionalProperties": false, "required": ["total", "observed", "declared", "missing"], "properties": {"total": {"type": "integer", "minimum": 0}, "observed": {"type": "integer", "minimum": 0}, "declared": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["events", "duplicate_ownership", "billing_verified"], "properties": {"events": {"type": "integer", "minimum": 0}, "duplicate_ownership": {"type": "integer", "minimum": 0}, "billing_verified": {"const": false}}},
    "completion": {"type": "object", "additionalProperties": false, "required": ["claims", "assessment"], "properties": {"claims": {"type": "array", "items": {"enum": ["claimed_complete", "claimed_incomplete", "not_claimed"]}}, "assessment": {"enum": ["not_claimed", "insufficient_evidence", "contradicted", "supported_by_supplied_evidence"]}}},
    "gaps": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "conflicts": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "gate": {"enum": ["hold", "review", "ready_for_human_decision"]},
    "decision_owner": {"type": "string"}, "assumptions": {"type": "array", "items": {"type": "string"}}, "exclusions": {"type": "array", "items": {"type": "string"}},
    "completion_verified": {"const": false}, "billing_verified": {"const": false}, "conformance_claim": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
