{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/assessment-scope-source-v1.json",
  "title": "Provider-neutral assessment scope declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_id", "declared_at", "subject", "deployment_subject", "rules", "default"],
  "properties": {
    "schema_version": {"const": "safe2.assessment-scope-source.v1"},
    "scope_id": {"$ref": "#/$defs/id"},
    "declared_at": {"type": "string", "format": "date-time", "maxLength": 50},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "system_fingerprint_sha256"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/id"},
        "system_fingerprint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "deployment_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "component_ids", "basis", "source_ref"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "type": {"enum": ["application", "service", "agent_system", "workstation", "repository", "component"]},
        "component_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "basis": {"enum": ["observed", "declared"]},
        "source_ref": {"$ref": "#/$defs/id"}
      }
    },
    "rules": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {"$ref": "#/$defs/rule"}
    },
    "default": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "disposition", "rationale"],
      "properties": {
        "classification": {"const": "unknown"},
        "disposition": {"enum": ["partial", "excluded"]},
        "rationale": {"$ref": "#/$defs/text"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "classification": {"enum": ["product", "test", "adversarial_fixture", "example", "research", "generated", "dependency", "third_party", "configuration", "documentation", "unknown"]},
    "disposition": {"enum": ["included", "excluded", "partial", "not_applicable"]},
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "patterns", "classification", "disposition", "component_ids", "rationale", "basis", "source_ref"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "patterns": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "classification": {"$ref": "#/$defs/classification"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "component_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "rationale": {"$ref": "#/$defs/text"},
        "basis": {"enum": ["observed", "declared"]},
        "source_ref": {"$ref": "#/$defs/id"}
      }
    }
  }
}
