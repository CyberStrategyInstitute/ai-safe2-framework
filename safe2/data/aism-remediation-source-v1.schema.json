{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/aism-remediation-source-v1.json",
  "title": "AISM implementation remediation source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "subject_id", "decision_owner", "bindings", "assumptions", "alternatives", "actions", "accepted_residual_risks"],
  "properties": {
    "schema_version": {"const": "safe2.aism-remediation-source.v1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "subject_id": {"$ref": "#/$defs/id"},
    "decision_owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment_sha256", "system_identity_sha256", "assessment_scope_sha256"],
      "properties": {
        "assessment_sha256": {"$ref": "#/$defs/sha256"},
        "system_identity_sha256": {"$ref": "#/$defs/sha256"},
        "assessment_scope_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assumptions": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/statement"}},
    "alternatives": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/alternative"}},
    "actions": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/action"}},
    "accepted_residual_risks": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/risk"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "statement": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "effect_if_false"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 1000}, "effect_if_false": {"type": "string", "minLength": 1, "maxLength": 1000}}
    },
    "alternative": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "pros", "cons", "reason_not_selected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 300},
        "pros": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "cons": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "reason_not_selected": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sequence", "title", "description", "status", "priority", "owner", "control_refs", "aism_cells", "evidence_refs", "assumption_refs", "dependencies", "alternative_refs", "impacts", "why", "why_not", "exit_criteria", "completion_evidence_refs", "residual_risk", "residual_risk_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 500},
        "title": {"type": "string", "minLength": 1, "maxLength": 300}, "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {"enum": ["planned", "in_progress", "blocked", "completed", "deferred", "accepted_risk"]},
        "priority": {"enum": ["critical", "high", "medium", "low"]}, "owner": {"type": "string", "minLength": 1, "maxLength": 200},
        "control_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "aism_cells": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[1-5]\\.D[1-6]$"}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "assumption_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "dependencies": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "alternative_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "impacts": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["perspective", "statement"], "properties": {"perspective": {"enum": ["ciso", "engineering", "governance", "operations", "agent"]}, "statement": {"type": "string", "minLength": 1, "maxLength": 1000}}}},
        "why": {"type": "string", "minLength": 1, "maxLength": 1000}, "why_not": {"type": "string", "minLength": 1, "maxLength": 1000},
        "exit_criteria": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "completion_evidence_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "residual_risk": {"type": "string", "minLength": 1, "maxLength": 1000},
        "residual_risk_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "owner", "rationale", "review_date", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "owner": {"type": "string", "minLength": 1, "maxLength": 200}, "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "review_date": {"type": "string", "format": "date"}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
