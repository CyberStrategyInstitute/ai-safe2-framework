{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisafe2.dev/schemas/claim-audit-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "created_at", "audit_id", "task_id", "source_sha256", "receipt_sha256", "claims", "summary", "gate", "completion_verified", "deception_inferred", "conformance_claim", "limitations", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "safe2.claim-audit.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "audit_id": {"type": "string"}, "task_id": {"type": "string"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "receipt_sha256": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim_type", "asserted_outcome", "status", "reason", "evidence_criteria_ids", "matched_criteria", "explicit_limitation_disclosure"],
      "properties": {
        "id": {"type": "string"}, "claim_type": {"type": "string"}, "asserted_outcome": {"type": "string"},
        "status": {"enum": ["evidence_consistent", "contradicted", "unverifiable"]},
        "reason": {"enum": ["all_referenced_criteria_supported", "referenced_criterion_contradicted", "referenced_outcome_conflicts_with_claim", "missing_or_unverifiable_criterion", "no_evidence_referenced"]},
        "evidence_criteria_ids": {"type": "array", "items": {"type": "string"}},
        "matched_criteria": {"type": "integer", "minimum": 0, "maximum": 100},
        "explicit_limitation_disclosure": {"type": "boolean"}
      }
    }},
    "summary": {"type": "object", "additionalProperties": false, "required": ["total", "evidence_consistent", "contradicted", "unverifiable", "explicit_limitation_disclosures", "evidence_coverage_ratio", "contradiction_ratio"], "properties": {
      "total": {"type": "integer", "minimum": 1}, "evidence_consistent": {"type": "integer", "minimum": 0}, "contradicted": {"type": "integer", "minimum": 0}, "unverifiable": {"type": "integer", "minimum": 0}, "explicit_limitation_disclosures": {"type": "integer", "minimum": 0},
      "evidence_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "contradiction_ratio": {"type": "number", "minimum": 0, "maximum": 1}
    }},
    "gate": {"enum": ["evidence_consistent", "review_required"]},
    "completion_verified": {"const": false}, "deception_inferred": {"const": false}, "conformance_claim": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "integrity_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
