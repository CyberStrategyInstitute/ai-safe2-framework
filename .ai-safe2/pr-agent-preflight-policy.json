{
  "schema_version": "safe2.pr-agent-preflight-policy.v1",
  "benchmark_version": "code-review-canary.v1",
  "candidate_pool": [
    "stealth/space-bunny-alpha",
    "qwen/qwen3.8-27b:free",
    "poolside/laguna-s-2.1:free",
    "cohere/north-mini-code:free",
    "nvidia/nemotron-3-ultra-550b-a55b:free",
    "nvidia/nemotron-3.5-lightning:free",
    "nvidia/nemotron-3-super-120b-a12b:free",
    "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
  ],
  "discovery": {
    "shortlist_size": 3,
    "minimum_context_tokens": 32000,
    "minimum_recent_uptime_percent": 75
  },
  "request": {
    "timeout_seconds": 30,
    "max_completion_tokens": 1200,
    "reasoning_max_tokens": 256,
    "temperature": 0
  },
  "selection": {
    "required_defects": {
      "authorization-after-read": "C2",
      "path-traversal": "C2"
    },
    "safe_line_ids": [
      "S1",
      "S2",
      "S3",
      "S4"
    ],
    "maximum_findings": 2,
    "maximum_response_characters": 2200
  },
  "pr_context": {
    "maximum_patch_characters": 12000,
    "priority_path_fragments": [
      ".github/workflows/",
      "auth",
      "policy",
      "security",
      "payment",
      "settlement",
      "evidence",
      "safe2/",
      "nexus/"
    ]
  }
}
