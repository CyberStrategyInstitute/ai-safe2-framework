{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/nexus/schemas/guardian-v0.3.schema.json",
  "title": "NEXUS Guardian Integration Profile v0.3, AI SAFE2 v3.1 compatibility",
  "description": "Wire format for the NEXUS-ACS Bridge Specification v0.1. The schema preserves AOS/ACS correlation fields while adding AI SAFE2 v3.1 protocol-independent persistence scopes. Legacy memory-zone values remain accepted during migration.",
  "type": "object",
  "required": ["jsonrpc", "method", "params", "id"],
  "properties": {
    "jsonrpc": {
      "type": "string",
      "const": "2.0",
      "description": "JSON-RPC protocol version."
    },
    "method": {
      "type": "string",
      "enum": [
        "steps/agentTrigger",
        "steps/knowledgeRetrieval",
        "steps/memoryStore",
        "steps/memoryContextRetrieval",
        "steps/message",
        "steps/toolCallRequest",
        "steps/toolCallResult",
        "protocols/mcp",
        "a2a/message",
        "nexus/guardianPing",
        "nexus/invariantCheck"
      ]
    },
    "id": {
      "oneOf": [
        {"type": "string"},
        {"type": "integer"}
      ],
      "description": "JSON-RPC request identifier used for protocol correlation. It is not the governance identity."
    },
    "params": {
      "$ref": "#/$defs/StepContext"
    }
  },
  "$defs": {
    "PersistenceScope": {
      "type": "string",
      "enum": ["request", "handle_scoped", "durable", "swarm_shared"],
      "description": "Canonical AI SAFE2 v3.1 persistence scope."
    },
    "LegacyMemoryZone": {
      "type": "string",
      "enum": [
        "SESSION",
        "SESSION_MEMORY",
        "CROSS_SESSION",
        "CROSS_SESSION_MEMORY",
        "PERMANENT",
        "PERMANENT_MEMORY",
        "SWARM_SHARED",
        "SWARM_SHARED_MEMORY",
        "request",
        "handle_scoped",
        "durable",
        "swarm_shared"
      ],
      "description": "Legacy NEXUS memory-zone compatibility field plus canonical v3.1 values. New implementations should also emit persistence_scope."
    },
    "StepContext": {
      "type": "object",
      "required": ["step_id", "agent"],
      "properties": {
        "step_id": {
          "type": "string",
          "description": "Unique identifier for this Guardian evaluation step."
        },
        "session_id": {
          "type": "string",
          "description": "Optional protocol/workflow correlation identifier. It is not identity, authorization, or persistence scope."
        },
        "agent": {
          "$ref": "#/$defs/NEXUSAgentContext"
        },
        "action": {
          "$ref": "#/$defs/ActionContext"
        },
        "memory": {
          "$ref": "#/$defs/MemoryContext"
        },
        "reasoning": {
          "type": "string"
        },
        "reasoning_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nexus_extension": {
          "$ref": "#/$defs/NEXUSExtension"
        }
      },
      "additionalProperties": true
    },
    "NEXUSAgentContext": {
      "type": "object",
      "required": ["id"],
      "description": "NEXUS agent identity. id preserves ACS compatibility; did/spiffe_id/aim_digest provide stronger NEXUS identity context when present.",
      "properties": {
        "id": {
          "type": "string"
        },
        "did": {
          "type": "string",
          "pattern": "^did:[a-z]+:.+"
        },
        "agent_did": {
          "type": "string",
          "pattern": "^did:[a-z]+:.+"
        },
        "spiffe_id": {
          "type": "string",
          "pattern": "^spiffe://.+"
        },
        "act_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "aim_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "granted_scopes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "ActionContext": {
      "type": "object",
      "required": ["method", "arguments"],
      "properties": {
        "method": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "arguments_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "server_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "MemoryContext": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": {
          "type": "array",
          "items": {"type": "string"}
        },
        "persistence_scope": {
          "$ref": "#/$defs/PersistenceScope"
        },
        "zone": {
          "$ref": "#/$defs/LegacyMemoryZone"
        },
        "state_handle_id": {
          "type": "string",
          "description": "Opaque identifier or evidence reference for handle-scoped state. Possession is not identity."
        },
        "provenance": {
          "$ref": "#/$defs/MemoryProvenance"
        },
        "drift_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "anyOf": [
        {"required": ["persistence_scope"]},
        {"required": ["zone"]}
      ],
      "additionalProperties": true
    },
    "MemoryProvenance": {
      "type": "object",
      "required": ["source_did", "embedding_hash"],
      "properties": {
        "source_did": {
          "type": "string",
          "pattern": "^did:[a-z]+:.+"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "embedding_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "persistence_scope": {
          "$ref": "#/$defs/PersistenceScope"
        },
        "zone_class": {
          "$ref": "#/$defs/LegacyMemoryZone"
        },
        "state_handle_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "Legacy correlation/state identifier retained for compatibility. Not identity or authorization."
        },
        "checkpoint_id": {
          "type": "string"
        },
        "checkpoint_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "mandate_id": {
          "type": ["string", "null"]
        },
        "drift_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "anyOf": [
        {"required": ["persistence_scope"]},
        {"required": ["zone_class"]}
      ],
      "additionalProperties": true
    },
    "NEXUSExtension": {
      "type": "object",
      "description": "NEXUS-specific fields carried alongside ACS/AOS-compatible context.",
      "properties": {
        "cael_envelope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "parent_scopes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "aism_violations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "joulework_balance": {
          "type": "number"
        },
        "persistence_scope": {
          "$ref": "#/$defs/PersistenceScope"
        },
        "state_handle_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "GuardianVerdict": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {"type": "string"},
            {"type": "integer"}
          ]
        },
        "result": {
          "type": "object",
          "required": ["decision"],
          "properties": {
            "decision": {
              "type": "string",
              "enum": ["allow", "deny", "modify"]
            },
            "step_id": {
              "type": "string"
            },
            "stepId": {
              "type": "string"
            },
            "deny_reason": {
              "type": "string"
            },
            "reason_codes": {
              "type": "array",
              "items": {"type": "string"}
            },
            "modified_request": {
              "type": "object"
            },
            "nor_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_id": {
              "type": "string"
            },
            "policy_version": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
